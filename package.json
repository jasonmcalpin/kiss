{
  "name": "kiss",
  "version": "0.1.0",
  "description": "raw javascript game",
  "main": "index.html",
  "scripts": {
    "test": "jest",
    "lint": "eslint frontend/src/",
    "format": "prettier --write frontend/src/",
    "start": "docker-compose up",
    "build:css": "tailwindcss -i ./frontend/src/assets/css/tailwind.css -o ./frontend/public/assets/css/output.css",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "keywords": [
    "game",
    "javascript"
  ],
  "author": "Jason McAlpin",
  "license": "ISC",
  "devDependencies": {
    "@babel/eslint-parser": "^7.28.0",
    "@eslint/js": "^9.30.1",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/parser": "^8.36.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.30.1",
    "eslint-plugin-prettier": "^5.5.1",
    "globals": "^16.3.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.0.4",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.11",
    "tailwindcss-cli": "^0.1.2",
    "ts-jest": "^29.4.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.5"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.11"
  }
